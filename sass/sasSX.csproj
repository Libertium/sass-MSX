<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>sasSX</RootNamespace>
    <AssemblyName>sasSX</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The assembly attributes live in Properties/AssemblyInfo.cs, kept as is. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Keep the output at bin/<Config>/sasSX.exe, the path the Makefile and the
         MSX Game Tools docs point at. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- The z80 tables are read at run time by name (Program.cs: LoadInternalSet
       "sasSX.Tables.z80.table"), so the resource id is pinned, not derived. -->
  <ItemGroup>
    <EmbeddedResource Include="Tables\z80.table" LogicalName="sasSX.Tables.z80.table" />
    <EmbeddedResource Include="Tables\z80alt.table" LogicalName="sasSX.Tables.z80alt.table" />
  </ItemGroup>

</Project>
